# ==============================================================================
# Fiti Backend Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL connection string)
# For asyncpg: will automatically convert postgresql:// to postgresql+asyncpg://
CONNECTION_STRING=postgresql://username:password@localhost:5432/fiti_db

# Firebase Authentication
# Use ADC by leaving both values empty, or configure exactly one credential source.
FIREBASE_CREDENTIALS_PATH=/secrets/firebase.json
FIREBASE_CREDENTIALS_JSON=

# Cloudinary Storage Configuration (Optional / if media upload is enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
