# ==============================================================================
# Fiti Backend Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL connection string)
# For asyncpg: will automatically convert postgresql:// to postgresql+asyncpg://
CONNECTION_STRING=postgresql://username:password@localhost:5432/fiti_db

# Firebase Authentication
# Local path to Firebase Service Account JSON file (ignored in production if using Google ADC)
FIREBASE_CREDENTIALS_PATH=fiti-b0cb2-firebase-adminsdk-fbsvc-0182bfc133.json
FIREBASE_PROJECT_ID=fiti-b0cb2

# Cloudinary Storage Configuration (Optional / if media upload is enabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
